@{
    ViewData["Title"] = "Acceso Denegado";
    Layout = "_LayoutAnonymous";
}

<div class="container d-flex align-items-center justify-content-center min-vh-100">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-danger text-white text-center py-3 rounded-top-4">
                <h5 class="mb-0"><i class="fas fa-ban me-2"></i>Acceso Denegado</h5>
            </div>
            <div class="card-body p-5 text-center">
                <div class="mb-4">
                    <i class="fas fa-exclamation-triangle text-danger" style="font-size: 5rem;"></i>
                </div>
                
                <h1 class="display-1 fw-bold text-danger">403</h1>
                <h4 class="mb-3">Acceso No Autorizado</h4>
                
                <p class="text-muted mb-4">
                    Lo sentimos, no tienes permisos para acceder a esta sección.
                    <br />
                    Por favor, inicia sesión con una cuenta que tenga los permisos necesarios o contacta al administrador.
                </p>

                <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                        <i class="fas fa-home me-2"></i>Ir al Inicio
                    </a>
                    <a asp-controller="Login" asp-action="Index" class="btn btn-secondary px-4">
                        <i class="fas fa-sign-in-alt me-2"></i>Iniciar Sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
