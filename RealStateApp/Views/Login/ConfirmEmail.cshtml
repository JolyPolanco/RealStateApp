@model string

@{
    ViewData["Title"] = "Confirmación de Email";
    Layout = "_LayoutAnonymous";
}

<div class="container d-flex align-items-center justify-content-center min-vh-100">
    <div class="col-12 col-sm-10 col-md-6 col-lg-5 col-xl-4">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-success text-white text-center py-3 rounded-top-4">
                <h5 class="mb-0"><i class="fas fa-check-circle me-2"></i>¡Email Confirmado!</h5>
            </div>
            <div class="card-body p-4 text-center">
                <div class="mb-4">
                    <i class="fas fa-check-circle text-success" style="font-size: 5rem;"></i>
                </div>
                
                <h4 class="mb-3">Cuenta Confirmada</h4>
                
                <p class="text-muted mb-4">
                    @Model
                </p>

                <a asp-controller="Login" asp-action="Index" class="btn btn-success w-100 py-2">
                    <i class="fas fa-sign-in-alt me-2"></i>Ir al Login
                </a>
            </div>
        </div>
    </div>
</div>
