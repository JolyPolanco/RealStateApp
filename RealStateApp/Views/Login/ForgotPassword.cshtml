@model RealStateApp.Core.Application.ViewModels.User.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = "_LayoutAnonymous";
}

<div class="container d-flex align-items-center justify-content-center min-vh-100">
    <div class="col-12 col-sm-10 col-md-6 col-lg-5 col-xl-4">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-warning text-dark text-center py-3 rounded-top-4">
                <h5 class="mb-0"><i class="fas fa-key me-2"></i>Recuperar Contraseña</h5>
            </div>
            <div class="card-body p-4">
                @if (Model?.HasError == true)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-times-circle me-2"></i>@Model.Error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="alert alert-info mb-4" role="alert">
                    <i class="fas fa-info-circle me-2"></i>
                    Ingresa tu nombre de usuario y te enviaremos un enlace para restablecer tu contraseña.
                </div>

                <form asp-controller="Login" asp-action="ForgotPassword" method="post">
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label">Nombre de Usuario</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-user"></i></span>
                            <input asp-for="UserName" class="form-control" placeholder="Ingresa tu usuario" autocomplete="username" />
                        </div>
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 py-2 mb-2">
                        <i class="fas fa-paper-plane me-2"></i>Enviar Enlace de Recuperación
                    </button>

                    <a asp-controller="Login" asp-action="Index" class="btn btn-secondary w-100 py-2">
                        <i class="fas fa-arrow-left me-2"></i>Volver al Login
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
