<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Real State App</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RealStateApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-home me-2"></i>Real State App
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    <i class="fas fa-home me-1"></i>Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Agent" asp-action="Index">
                                    <i class="fas fa-users me-1"></i>Agentes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="User" asp-action="Register">
                                    <i class="fas fa-user-plus me-1"></i>Únete a la app
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary text-white ms-2 px-3" asp-controller="Login" asp-action="Index">
                                    <i class="fas fa-sign-in-alt me-1"></i>Iniciar Sesión
                                </a>
                            </li>
                        </ul>
                    }
                    else if (User.IsInRole("CLIENT"))
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    <i class="fas fa-home me-1"></i>Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Agent" asp-action="Index">
                                    <i class="fas fa-users me-1"></i>Agentes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Property" asp-action="MyFavorites">
                                    <i class="fas fa-heart me-1"></i>Mis Propiedades
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle me-1"></i>@User.Identity.Name
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Login" asp-action="Logout">
                                            <i class="fas fa-sign-out-alt me-1"></i>Cerrar Sesión
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else if (User.IsInRole("AGENT"))
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Agent" asp-action="Index">
                                    <i class="fas fa-home me-1"></i>Home del Agente
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Agent" asp-action="Profile">
                                    <i class="fas fa-user me-1"></i>Mi Perfil
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Property" asp-action="Index">
                                    <i class="fas fa-building me-1"></i>Mantenimiento de Propiedades
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle me-1"></i>@User.Identity.Name
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Login" asp-action="Logout">
                                            <i class="fas fa-sign-out-alt me-1"></i>Cerrar Sesión
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else if (User.IsInRole("ADMIN") || User.IsInRole("DEVELOPER"))
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                    <i class="fas fa-tachometer-alt me-1"></i>Home del Administrador
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Agent" asp-action="List">
                                    <i class="fas fa-users me-1"></i>Listado de Agentes
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-cog me-1"></i>Mantenimientos
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="User" asp-action="Admins">
                                            <i class="fas fa-user-shield me-1"></i>Administradores
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="User" asp-action="Developers">
                                            <i class="fas fa-code me-1"></i>Desarrolladores
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="PropertyType" asp-action="Index">
                                            <i class="fas fa-home me-1"></i>Tipos de Propiedades
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="SaleType" asp-action="Index">
                                            <i class="fas fa-tag me-1"></i>Tipos de Ventas
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Improvement" asp-action="Index">
                                            <i class="fas fa-wrench me-1"></i>Mejoras
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle me-1"></i>@User.Identity.Name
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Login" asp-action="Logout">
                                            <i class="fas fa-sign-out-alt me-1"></i>Cerrar Sesión
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3 bg-light">
        <div class="container text-center">
            &copy; 2025 - Real State App - Todos los derechos reservados
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
