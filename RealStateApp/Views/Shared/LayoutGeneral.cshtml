<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealStateApp</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/%40mdi/font%407.4.47/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/3.0.0/uicons-solid-rounded/css/uicons-solid-rounded.css">
    <script src="https://cdn.tailwindcss.com"></script>


    <link rel="stylesheet" href="~/css/output.css" />

    <style>
        :root {
            --primary-bg: #F4F6F9;
            --secondary-bg: #FFFFFF;
            --accent-color: #0D6EFD;
            --hover-bg: #E7F1FF;
            --text-dark: #212529;
            --text-muted: #6C757D;
        }
    </style>
</head>

<body class="flex flex-col min-h-screen bg-[var(--primary-bg)] text-[var(--text-dark)] font-sans">

  
    <header class="bg-gradient-to-br from-black via-gray-900 to-gray-800 shadow-xl rounded-b-xl">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">

            <a asp-controller="Home" asp-action="DataProperty"
               class="flex items-center gap-2 text-white font-bold text-xl">
                <i class="fi fi-sr-home-heart"></i> RealStateApp
            </a>

         
            <nav class="flex items-center gap-4">

                <a asp-controller="Home" asp-action="DataProperty"
                   class="px-3 py-2 rounded-lg hover:bg-white/10 text-white flex items-center gap-1 transition">
                    <i class="fi fi-sr-home"></i> HOME
                </a>

                <a asp-controller="Home" asp-action="Agents"
                   class="px-3 py-2 rounded-lg hover:bg-white/10 text-white flex items-center gap-1 transition">
                    <i class="fi fi-sr-users"></i> Agentes
                </a>

                <a asp-controller="User" asp-action="Register"
                   class="px-3 py-2 rounded-lg hover:bg-white/10 text-white flex items-center gap-1 transition">
                    <i class="fi fi-sr-user-add"></i> Únete
                </a>

                <a asp-controller="Login" asp-action="Index"
                   class="px-4 py-2 bg-blue-600 text-white rounded-lg shadow hover:bg-blue-700 transition flex items-center gap-1">
                    <i class="fi fi-sr-sign-in-alt"></i> Iniciar Sesión
                </a>

            </nav>
        </div>
    </header>

 
    <main class="flex-1 max-w-7xl mx-auto px-6 py-8 w-full">
        @RenderBody()
    </main>

    <footer class="bg-[var(--secondary-bg)] text-center py-4 text-[var(--text-muted)] shadow-inner mt-auto">
        &copy; @DateTime.Now - RealStateApp
    </footer>

   
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.15.0/dist/cdn.min.js" defer></script>
    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


