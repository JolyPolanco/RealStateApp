@using RealStateApp.Core.Application.ViewModels.Properties
@model PropertyListViewModel

@{
    Layout = "LayoutGeneral";
    ViewData["Title"] = "Propiedades del agente";

}

<section class="w-full">
    <div class="relative h-64 md:h-72 lg:h-96 overflow-hidden rounded-b-lg shadow-md">
        <img src="https://libros-conaliteg-sep.com.mx/wp-content/uploads/inmobiliario.jpg"
             alt="Banner propiedades del agente"
             class="absolute inset-0 w-full h-full object-cover filter brightness-75" />
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4">
            <h1 class="text-2xl md:text-4xl lg:text-5xl font-extrabold text-white drop-shadow">
                Propiedades del agente
            </h1>
            <p class="mt-2 text-sm md:text-lg text-gray-200 max-w-2xl">
                Explora las propiedades disponibles gestionadas por este agente.
            </p>
        </div>
    </div>
</section>

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    @if (Model?.DataProperties == null || !Model.DataProperties.Any())
    {
        <div class="rounded-lg bg-gray-50 border border-gray-200 p-8 text-center">
            <h3 class="mt-4 text-lg font-semibold text-gray-900">
                No hay propiedades disponibles para este agente.
            </h3>
            <p class="mt-2 text-sm text-gray-500">
                Vuelve más tarde o explora otras propiedades.
            </p>

            <a asp-action="Agents" asp-controller="Home" 
               class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                Ver todos los agentes
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var item in Model.DataProperties)
            {
                <article class="bg-white rounded-lg shadow-md overflow-hidden group hover:shadow-lg transition-shadow duration-300">
                    <a asp-action="DetailsProperty" asp-controller="Home" asp-route-propertyId="@item.Id" class="block">
                        <div class="relative h-48 w-full overflow-hidden">
                            <img src="@(string.IsNullOrWhiteSpace(item.Photo) ? "/images/placeholder-house.jpg" : Url.Content(item.Photo))"
                                 alt="Imagen propiedad"
                                 class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition duration-300" />
                        </div>
                        <div class="p-4">
                            <div class="flex items-start justify-between">
                                <div>
                                    <h3 class="text-lg font-semibold text-gray-900">@item.TypeProperty</h3>
                                    <p class="text-sm text-gray-500 mt-0.5">Código: <span class="font-medium text-gray-700">@item.Code</span></p>
                                </div>
                                <div class="text-right">
                                    <p class="text-sm text-gray-500">@item.SaleType</p>
                                    <p class="text-lg font-bold text-blue-600 mt-1">RD$ @string.Format("{0:N2}", item.Price)</p>
                                </div>
                            </div>
                            <div class="mt-3 flex items-center text-sm text-gray-600 gap-4">
                                <div class="flex items-center gap-2">
                                    <img src="~/Images/room.png" class="h-5 w-5 object-contain" />
                                    <span>@item.Bedrooms</span><span class="text-gray-400">hab</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <img src="~/Images/bathroom.png" class="h-5 w-5 object-contain" />
                                    <span>@item.Bathrooms</span><span class="text-gray-400">baños</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <img src="~/Images/spatial.png" class="h-5 w-5 object-contain" />
                                    <span>@item.SizeInMeters m²</span>
                                </div>
                            </div>
                        </div>
                    </a>

                   
                </article>
            }
        </div>
    }
</section>

