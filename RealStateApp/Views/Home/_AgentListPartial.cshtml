@model AgentDataListViewModel

@{
   
    ViewData["Title"] = "Filtro";

}

@if (Model?.Agents == null || !Model.Agents.Any())
{
    <div class="rounded-lg bg-gray-50 border border-gray-200 p-8 text-center">
        <h3 class="mt-4 text-lg font-semibold text-gray-900">
            No se encontraron agentes que coincidan con la búsqueda.
        </h3>
        <p class="mt-2 text-sm text-gray-500">
            Intenta con otro nombre o limpia el filtro para ver todos los agentes.
        </p>
        <div class="mt-4">
            <a asp-action="Agents" asp-controller="Home" 
               class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                Ver todos los agentes
            </a>
        </div>
    </div>
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        @foreach (var agent in Model.Agents.OrderBy(a => a.FirstName).ThenBy(a => a.LastName))
        {
            <a asp-action="AgentProperty"asp-controller="Home"   asp-route-agentId="@agent.Id" class="block bg-white rounded-lg shadow hover:shadow-lg transition-shadow duration-300 overflow-hidden">
                <div class="h-48 w-full overflow-hidden">
                    <img src="@Url.Content(agent.UrlImage)" alt="@($"{agent.FirstName} {agent.LastName}")" class="object-cover w-full h-full">
                </div>
                <div class="p-4 text-center">
                    <h3 class="text-lg font-semibold text-gray-900">@($"{agent.FirstName} {agent.LastName}")</h3>
                </div>
            </a>
        }
    </div>
}

