@using RealStateApp.Core.Application.ViewModels.Properties
@model DetailsPropertyCompleteViewModel

@{

    Layout = "LayoutGeneral";
    ViewData["Title"] = "Detalle de la propiedad";
}

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900">Detalle de la propiedad</h1>
            <p class="text-sm text-gray-500 mt-1">Información completa, contacto con el agente, ofertas y chat.</p>
        </div>

    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-lg shadow overflow-hidden">

                <div class="relative w-full h-72 md:h-96 bg-gray-100">
                    @if (Model.DetailsPropertyViewModel.Images != null && Model.DetailsPropertyViewModel.Images.Any())
                    {
                        <div id="slides" class="relative w-full h-full">
                            @for (int i = 0; i < Model.DetailsPropertyViewModel.Images.Count; i++)
                            {
                                var img = Model.DetailsPropertyViewModel.Images[i];
                                <img data-index="@i" src="@Url.Content(img)"
                                     class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 @(i == 0 ? "" : "hidden")" />
                            }
                        </div>
                    }
                    else
                    {
                        <img src="/images/placeholder-house.jpg" alt="No image" class="w-full h-full object-cover" />
                    }


                    <button id="prevBtn" class="absolute left-3 top-1/2 -translate-y-1/2 bg-white/90 p-2 rounded-full shadow hover:bg-white">
                        <svg class="h-5 w-5 text-gray-800" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" /></svg>
                    </button>
                    <button id="nextBtn" class="absolute right-3 top-1/2 -translate-y-1/2 bg-white/90 p-2 rounded-full shadow hover:bg-white">
                        <svg class="h-5 w-5 text-gray-800" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" /></svg>
                    </button>


                    <div id="dots" class="absolute left-1/2 -translate-x-1/2 bottom-3 flex gap-2">
                        @if (Model.DetailsPropertyViewModel.Images != null)
                        {
                            for (int d = 0; d < Model.DetailsPropertyViewModel.Images.Count; d++)
                            {
                                <button data-dot="@d" class="w-2 h-2 rounded-full bg-white/50"></button>
                            }
                        }
                    </div>

                    <div class="absolute left-4 top-4 bg-white/95 px-3 py-2 rounded-lg shadow">
                        <div class="text-xs text-gray-600">Código</div>
                        <div class="text-sm font-semibold">@Model.DetailsPropertyViewModel.Code</div>
                    </div>
                </div>


                <div class="px-6 py-4">
                    <div class="flex items-start justify-between gap-6">
                        <div>
                            <h2 class="text-2xl font-bold text-gray-900">@Model.DetailsPropertyViewModel.PropertyType</h2>
                            <p class="text-sm text-gray-500 mt-0.5">@Model.DetailsPropertyViewModel.SaleType</p>
                        </div>

                        <div class="text-right">
                            <div class="text-xl md:text-2xl font-extrabold text-blue-600">RD$ @string.Format("{0:N2}", Model.DetailsPropertyViewModel.Price)</div>
                        </div>
                    </div>

                    <div class="mt-4 grid grid-cols-3 gap-4 text-sm text-gray-700">
                        <div class="flex flex-col items-center bg-white shadow rounded-lg p-3">
                            <span class="text-xs text-gray-500">Habitaciones</span>
                            <div class="flex items-center gap-1 mt-1">
                                <img src="~/Images/room.png" class="h-5 w-5 object-contain" />
                                <span class="font-medium"> @Model.DetailsPropertyViewModel.Bedrooms </span>
                            </div>
                        </div>
                        <div class="flex flex-col items-center bg-white shadow rounded-lg p-3">
                            <span class="text-xs text-gray-500">Baños</span>
                            <div class="flex items-center gap-1 mt-1">
                                <img src="~/Images/bathroom.png" class="h-5 w-5 object-contain" />
                                <span class="font-medium"> @Model.DetailsPropertyViewModel.Bathrooms </span>
                            </div>
                        </div>
                        <div class="flex flex-col items-center bg-white shadow rounded-lg p-3">
                            <span class="text-xs text-gray-500">Tamaño</span>
                            <div class="flex items-center gap-1 mt-1">
                                <img src="~/Images/modern-house.png" class="h-5 w-5 object-contain" />
                                <span class="font-medium"> @Model.DetailsPropertyViewModel.SizeInMeters m²</span>
                            </div>
                        </div>
                    </div>


                    <hr class="my-4" />

                    <div>
                        <h3 class="text-lg font-semibold text-gray-900">Descripción</h3>
                        <p class="mt-2 text-gray-700">@Model.DetailsPropertyViewModel.Description</p>
                    </div>

                    <div class="mt-4">
                        <h3 class="text-lg font-semibold text-gray-900">Mejoras</h3>
                        @if (Model.DetailsPropertyViewModel.Inproments != null && Model.DetailsPropertyViewModel.Inproments.Any())
                        {
                            <div class="mt-2 grid grid-cols-1 md:grid-cols-2 gap-4">
                                @foreach (var imp in Model.DetailsPropertyViewModel.Inproments)
                                {
                                    <div class="bg-white shadow rounded-lg p-3 hover:shadow-lg transition-shadow">
                                        <span class="text-gray-700">@imp</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="mt-2 text-gray-500">No hay mejoras registradas.</p>
                        }
                    </div>
                </div>
            </div>



        </div>

        <aside class="space-y-6 lg:mt-80">

            <div class="bg-gradient-to-r from-white to-gray-50 rounded-2xl shadow-lg p-6 flex flex-col gap-4">

                <div class="flex justify-center">
                    <img src="@(string.IsNullOrWhiteSpace(Model.DetailsPropertyViewModel.UrlImage) ? "/images/avatar-placeholder.png" : Model.DetailsPropertyViewModel.UrlImage)"
                         class="w-24 h-24 rounded-full object-cover border-4 border-indigo-100 shadow-md" />
                </div>


                <div class="text-center">
                    <div class="text-sm text-gray-500">Agente</div>
                    <div class="text-xl font-bold text-gray-900">@Model.DetailsPropertyViewModel.Name</div>
                </div>


                <div class="flex flex-col gap-2">
                    <div class="flex items-center gap-2 text-gray-700">
                        <img src="~/Images/gmail.png" class="h-5 w-5 object-contain" />
                        <span class="font-medium">@Model.DetailsPropertyViewModel.Email</span>
                    </div>

                    <div class="flex items-center gap-2 text-gray-700">
                        <img src="~/Images/phone-call.png" class="h-5 w-5 object-contain" />
                        <span class="font-medium">@Model.DetailsPropertyViewModel.PhoneNumber</span>
                    </div>

                    <div class="flex items-center gap-2 text-gray-700">
                        <img src="~/Images/chat.png" class="h-5 w-5 object-contain" />
                        <span class="font-medium">@Model.DetailsPropertyViewModel.PhoneNumber (WhatsApp)</span>
                    </div>
                </div>

                <div class="mt-4 flex justify-center">
                </div>
            </div>


            <div class="bg-white rounded-lg shadow p-4 text-sm text-gray-600">
                <div><strong>Ubicación:</strong> MAP </div>
                <div class="mt-2"><strong>Código:</strong> @Model.DetailsPropertyViewModel.Code</div>
            </div>
        </aside>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        (function () {
                   const slides = document.querySelectorAll('#slides img');
                   if (!slides || slides.length === 0) return;

                   let idx = 0;
                   const show = (i) => {
                       slides.forEach((s, si) => {
                           s.classList.toggle('block', si === i);
                           s.classList.toggle('hidden', si !== i);
                       });
                       document.querySelectorAll('#dots button')?.forEach(b => b.classList.remove('bg-white'));
                       const btn = document.querySelector('#dots button[data-dot="' + i + '"]');
                       if (btn) btn.classList.add('bg-white');
                   };

                   document.getElementById('prevBtn')?.addEventListener('click', () => {
                       idx = (idx - 1 + slides.length) % slides.length;
                       show(idx);
                   });
                   document.getElementById('nextBtn')?.addEventListener('click', () => {
                       idx = (idx + 1) % slides.length;
                       show(idx);
                   });

                   document.querySelectorAll('#dots button')?.forEach(b => {
                       b.addEventListener('click', (e) => {
                           idx = parseInt(e.currentTarget.getAttribute('data-dot'));
                           show(idx);
                       });
                   });

                   show(0);
               })();
    </script>
}