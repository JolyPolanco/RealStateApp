@model PropertyListViewModel



@{
    Layout = "_ClientLayout";
    ViewData["Title"] = "Propiedades Favoritas";
}


<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <section class="w-full">
        <div class="relative h-64 md:h-72 lg:h-96 overflow-hidden rounded-b-lg shadow-md">

          
            <img src="https://cdn.amebaowndme.com/madrid-prd/madrid-web/images/sites/1923174/7a2a3d0df96f4e6c83d5fabcd95c23c9_ea97c6cccc288e873bd86bb5cd38370c.png"
                 alt="Banner propiedades"
                 class="absolute inset-0 w-full h-full object-cover" />

         
            <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/30"></div>

         
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4">

                <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight
                       bg-clip-text text-transparent
                       bg-gradient-to-r from-yellow-300 to-yellow-500 drop-shadow-xl">
                    ¡Decídete ya!
                </h1>

                <p class="mt-3 text-sm md:text-lg text-gray-100 font-medium drop-shadow">
                    Empieza a invertir en tu hogar ideal hoy mismo
                </p>

            </div>
        </div>
    </section>


    <div class="w-full h-12 flex items-center justify-center">
        <div class="w-32 h-1 bg-gray-300 rounded-full"></div>
    </div>


    @if (Model?.DataProperties == null || !(Model.DataProperties?.Any() ?? false))
    {
        <div class="rounded-lg bg-gray-50 border border-gray-200 p-10 text-center shadow-sm">

            <h3 class="text-xl font-semibold text-gray-900">
                No tienes propiedades marcadas como favoritas aún.
            </h3>

            <p class="mt-3 text-sm text-gray-600">
                Empieza a explorar y marca tus propiedades preferidas.
            </p>

            <div class="mt-6">
                <a asp-action="Index" asp-controller="Home" asp-area="Clients"
                   class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 shadow-md">
                    Ver propiedades disponibles
                </a>
            </div>
        </div>
    }
    else
    {
       
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

            @foreach (var item in Model.DataProperties)
            {
                <article class="bg-white rounded-xl shadow-md overflow-hidden group hover:shadow-lg transition">

                   
                    <a asp-action="DetailsProperty"
                       asp-controller="Home"
                       asp-area="Clients"
                       asp-route-propertyId="@item.Id"
                       class="block">

                       
                        <div class="relative h-48 w-full overflow-hidden">
                            <img src="@(string.IsNullOrWhiteSpace(item.Photo)
                                                                             ? Url.Content("/images/placeholder-house.jpg")
                                                                             : Url.Content(item.Photo))"
                         alt="Imagen propiedad"
                         class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition duration-300" />
                </div>

                       
                        <div class="p-4">
                            <div class="flex items-start justify-between">
                                <div>
                                    <h3 class="text-lg font-semibold text-gray-900">@item.TypeProperty</h3>
                                    <p class="text-sm text-gray-500 mt-0.5">
                                        Código:
                                        <span class="font-medium">@item.Code</span>
                                    </p>
                                </div>

                                <div class="text-right">
                                    <p class="text-sm text-gray-500">@item.SaleType</p>
                                    <p class="text-lg font-bold text-blue-600 mt-1">
                                        RD$ @string.Format("{0:N2}", item.Price)
                                    </p>
                                </div>
                            </div>

                            <div class="mt-3 flex items-center text-sm text-gray-600 gap-4">

                                <div class="flex items-center gap-2">
                                    <img src="~/Images/room.png" class="h-5 w-5 object-contain" />
                                    <span>@item.Bedrooms hab</span>
                                </div>

                                <div class="flex items-center gap-2">
                                    <img src="~/Images/bathroom.png" class="h-5 w-5 object-contain" />
                                    <span>@item.Bathrooms baños</span>
                                </div>

                                <div class="flex items-center gap-2">
                                    <img src="~/Images/spatial.png" class="h-5 w-5 object-contain" />
                                    <span>@item.SizeInMeters m²</span>
                                </div>

                            </div>

                        </div>
                    </a>

                    <div class="border-t px-4 py-3 bg-white flex justify-end">

                        <div class="w-40">
                    @if (item.IsFavorite)
                            {
                                <form asp-action="MarkAsNoFavorite"
                                      asp-controller="Home"
                                      asp-area="Clients"
                                      method="post">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="id" value="@item.FavoriteId" />
                                    <input type="hidden" name="ReturnUrl"
                                           value="@Url.Action("FavoriteProperty", "Home", new { area = "Clients" })" />

                                    <button type="submit"
                                            class="w-full inline-flex items-center justify-center gap-2 px-3 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">

                                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M12 21s-7.5-4.5-9.5-8.5A5.5 5.5 0 0112 3a5.5 5.5 0 019.5 9.5C19.5 16.5 12 21 12 21z" />
                                        </svg>

                                        Es favorita
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="MarkAsFavorite"
                                      asp-controller="Home"
                                      asp-area="Clients"
                                      method="post">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="PropertyId" value="@item.Id" />
                                    <input type="hidden" name="ClientId" value="@item.ClientId" />
                                    <input type="hidden" name="ReturnUrl"
                                           value="@Url.Action("FavoriteProperty", "Home", new { area = "Clients" })" />

                                    <button type="submit"
                                            class="w-full inline-flex items-center justify-center gap-2 px-3 py-2 border border-blue-600 text-blue-600 rounded-lg hover:bg-blue-50">

                                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                                  d="M12 21s-7.5-4.5-9.5-8.5A5.5 5.5 0 0112 3a5.5 5.5 0 019.5 9.5C19.5 16.5 12 21 12 21z" />
                                        </svg>

                                        Marcar favorita
                                    </button>
                                </form>
                            }
                        </div>

                    </div>
                </article>
            }
        </div>
    }
</section>
