@model PropertyListViewModel

@if (Model?.DataProperties == null || !(Model.DataProperties?.Any() ?? false))
{
    <div class="rounded-lg bg-gray-50 border border-gray-200 p-8 text-center">
        <h3 class="mt-4 text-lg font-semibold text-gray-900">
            @TempData["Error"] "No hay propiedades disponibles que coincidan con la búsqueda."
        </h3>
        <p class="mt-2 text-sm text-gray-500">
            Intenta con otros filtros o limpia los filtros para ver todas las propiedades.
        </p>
        <div class="mt-4">
            <a asp-action="Index" asp-controller="Home" asp-area="Clients"
               class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                Ver todas las propiedades
            </a>
        </div>
    </div>
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var item in Model.DataProperties)
        {
           
            <article class="bg-white rounded-lg shadow-md overflow-hidden group">
                <a asp-action="DetailsProperty" asp-controller="Home" asp-area="Clients" asp-route-propertyId="@item.Id" class="block">
                    <div class="relative h-48 w-full overflow-hidden">
                        <img src="@(string.IsNullOrWhiteSpace(item.Photo) ? "/images/placeholder-house.jpg" : item.Photo)"
                             alt="Imagen propiedad"
                             class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition duration-300" />
                    </div>
                    <div class="p-4">
                        <div class="flex items-start justify-between">
                            <div>
                                <h3 class="text-lg font-semibold text-gray-900">@item.TypeProperty</h3>
                                <p class="text-sm text-gray-500 mt-0.5">Código: <span class="font-medium text-gray-700">@item.Code</span></p>
                            </div>
                            <div class="text-right">
                                <p class="text-sm text-gray-500">@item.SaleType</p>
                                <p class="text-lg font-bold text-blue-600 mt-1">RD$ @string.Format("{0:N2}", item.Price)</p>
                            </div>
                        </div>
                        <div class="mt-3 flex items-center text-sm text-gray-600 gap-4">
                            <div class="flex items-center gap-2">
                                <img src="~/Images/room.png" class="h-5 w-5 object-contain" />
                                <span>@item.Bedrooms</span><span class="text-gray-400">hab</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <img src="~/Images/bathroom.png" class="h-5 w-5 object-contain" />
                                <span>@item.Bathrooms</span><span class="text-gray-400">baños</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <img src="~/Images/spatial.png" class="h-5 w-5 object-contain" />
                                <span>@item.SizeInMeters m²</span>
                            </div>
                        </div>
                    </div>
                </a>

                <div class="border-t px-4 py-3 bg-white flex items-center justify-between">
                    <div class="text-sm text-gray-600">
                        @* Más info opcional *@
                    </div>

                    <div class="w-36">
                        @if (item.IsFavorite)
                        {
                            <form asp-action="MarkAsNoFavorite" asp-controller="Home" asp-area="Clients" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.FavoriteId" />
                                <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-3 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">
                                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12 21s-7.5-4.5-9.5-8.5A5.5 5.5 0 0112 3a5.5 5.5 0 019.5 9.5C19.5 16.5 12 21 12 21z" />
                                    </svg>
                                    Es favorita
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="MarkAsFavorite" asp-controller="Home" asp-area="Clients" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="PropertyId" value="@item.Id" />
                                <input type="hidden" name="ClientId" value="@item.ClientId" />
                                <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-3 py-2 border border-blue-600 text-blue-600 rounded-lg hover:bg-blue-50">
                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21s-7.5-4.5-9.5-8.5A5.5 5.5 0 0112 3a5.5 5.5 0 019.5 9.5C19.5 16.5 12 21 12 21z" />
                                    </svg>
                                    Marcar favorita
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
}
