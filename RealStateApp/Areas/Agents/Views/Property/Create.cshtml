@model RealStateApp.Core.Application.ViewModels.Properties.SavePropertyViewModel

@{
    Layout = "_AgentLayout";
    ViewData["Title"] = Model.Id.HasValue ? "Editar Propiedad" : "Nueva Propiedad";
    var isEdit = Model.Id.HasValue;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@(isEdit ? "Editar Propiedad" : "Nueva Propiedad")</h4>
                </div>
                <div class="card-body p-4">
                    @if (Model.HasError)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>Error:</strong> @Model.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <h5>Por favor corrija los siguientes errores:</h5>
                            <ul>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <form action="@(isEdit ? "/Agents/Property/Edit" : "/Agents/Property/Create")" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="PropertyTypeId" class="form-label">Tipo de Propiedad</label>
                                <select name="PropertyTypeId" id="PropertyTypeId" class="form-select">
                                    <option value="">-- Seleccione tipo de propiedad (Casa, Apartamento, etc.) --</option>
                                    @if (ViewBag.PropertyTypes != null)
                                    {
                                        @foreach (var item in ViewBag.PropertyTypes)
                                        {
                                            <option value="@item.Value" @(Model.PropertyTypeId.ToString() == item.Value ? "selected" : "")>@item.Text</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="PropertyTypeId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="SaleTypeId" class="form-label">Tipo de Venta</label>
                                <select name="SaleTypeId" id="SaleTypeId" class="form-select">
                                    <option value="">-- Seleccione tipo de venta (Venta, Alquiler, etc.) --</option>
                                    @if (ViewBag.SaleTypes != null)
                                    {
                                        @foreach (var item in ViewBag.SaleTypes)
                                        {
                                            <option value="@item.Value" @(Model.SaleTypeId.ToString() == item.Value ? "selected" : "")>@item.Text</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="SaleTypeId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="Price" class="form-label">Precio</label>
                                <input name="Price" id="Price" class="form-control" type="number" step="0.01" placeholder="Ej: 150000.00" value="@Model.Price" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label for="SizeInMeters" class="form-label">Tamaño en m²</label>
                                <input name="SizeInMeters" id="SizeInMeters" class="form-control" type="number" step="0.01" placeholder="Ej: 120.50" value="@Model.SizeInMeters" />
                                <span asp-validation-for="SizeInMeters" class="text-danger"></span>
                            </div>

                            <div class="col-md-2 mb-3">
                                <label for="Bedrooms" class="form-label">Habitaciones</label>
                                <input name="Bedrooms" id="Bedrooms" class="form-control" type="number" min="1" placeholder="Ej: 3" value="@Model.Bedrooms" />
                                <span asp-validation-for="Bedrooms" class="text-danger"></span>
                            </div>

                            <div class="col-md-2 mb-3">
                                <label for="Bathrooms" class="form-label">Baños</label>
                                <input name="Bathrooms" id="Bathrooms" class="form-control" type="number" min="1" placeholder="Ej: 2" value="@Model.Bathrooms" />
                                <span asp-validation-for="Bathrooms" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="Description" class="form-label">Descripción</label>
                            <textarea name="Description" id="Description" class="form-control" rows="4" placeholder="Describe la propiedad: ubicación, características especiales, estado, etc.">@Model.Description</textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImprovementIds" class="form-label">Mejoras</label>
                            <select asp-for="ImprovementIds" class="form-select" multiple size="5">
                                @if (ViewBag.Improvements != null)
                                {
                                    @foreach (var item in ViewBag.Improvements)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                            <small class="form-text text-muted">Mantén presionada la tecla Ctrl (o Cmd en Mac) para seleccionar múltiples opciones (Piscina, Gimnasio, etc.)</small>
                            <span asp-validation-for="ImprovementIds" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Photos" class="form-label"></label>
                            
                            @if (isEdit && Model.ExistingPhotos != null && Model.ExistingPhotos.Any())
                            {
                                <div class="row mb-2">
                                    @foreach (var photo in Model.ExistingPhotos)
                                    {
                                        <div class="col-md-3 mb-2">
                                            <img src="@photo" alt="Foto de la propiedad" class="img-thumbnail" />
                                        </div>
                                    }
                                </div>
                                <small class="form-text text-muted d-block mb-2">Fotos actuales. Si selecciona nuevas imágenes, se reemplazarán todas.</small>
                            }
                            
                            <input name="Photos" id="Photos" class="form-control" type="file" accept="image/*" multiple />
                            <span asp-validation-for="Photos" class="text-danger"></span>
                            <small class="form-text text-muted">
                                @if (isEdit)
                                {
                                    <text>Opcional en edición. Seleccione de 1 a 4 imágenes para reemplazar las actuales.</text>
                                }
                                else
                                {
                                    <text>Requerido. Seleccione de 1 a 4 imágenes.</text>
                                }
                            </small>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a href="/Agents/Property/Index" class="btn btn-secondary">
                                <i class="fi fi-sr-arrow-left"></i> Volver
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fi fi-sr-disk"></i> @(isEdit ? "Guardar Cambios" : "Crear Propiedad")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .card {
        border-radius: 12px;
        border: none;
    }

    .card-header {
        border-radius: 12px 12px 0 0 !important;
        padding: 1.25rem;
    }

    .form-label {
        font-weight: 500;
        color: #495057;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #17A2B8;
        box-shadow: 0 0 0 0.2rem rgba(23, 162, 184, 0.25);
    }
</style>
