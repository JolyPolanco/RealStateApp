@model RealStateApp.Core.Application.ViewModels.User.EditAgentProfileViewModel

@{
    Layout = "_AgentLayout";
    ViewData["Title"] = "Mi Perfil";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Mi Perfil</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (Model.HasError)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @Model.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form action="/Agents/Profile/Index" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                <h5>Por favor corrija los siguientes errores:</h5>
                                <ul>
                                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="FirstName" class="form-label">Nombre</label>
                                <input name="FirstName" id="FirstName" class="form-control" type="text" value="@Model.FirstName" placeholder="Ej: Juan" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="LastName" class="form-label">Apellido</label>
                                <input name="LastName" id="LastName" class="form-control" type="text" value="@Model.LastName" placeholder="Ej: Pérez" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="PhoneNumber" class="form-label">Teléfono</label>
                            <input name="PhoneNumber" id="PhoneNumber" class="form-control" type="tel" value="@Model.PhoneNumber" placeholder="Ej: 809-555-1234" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label for="PhotoFile" class="form-label">Foto de Usuario</label>
                            @if (!string.IsNullOrEmpty(Model.Photo))
                            {
                                <div class="mb-2">
                                    <p class="text-muted small">Foto actual:</p>
                                    <img src="@Model.Photo" alt="Foto actual" class="img-thumbnail" style="max-width: 200px;" />
                                </div>
                            }
                            <input name="PhotoFile" id="PhotoFile" class="form-control" type="file" accept="image/*" />
                            <span asp-validation-for="PhotoFile" class="text-danger"></span>
                            <small class="form-text text-muted">Opcional. Seleccione una nueva imagen para cambiar su foto de perfil</small>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a href="/Agents/Home/Index" class="btn btn-secondary">
                                <i class="fi fi-sr-arrow-left"></i> Volver
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fi fi-sr-disk"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .card {
        border-radius: 12px;
        border: none;
    }

    .card-header {
        border-radius: 12px 12px 0 0 !important;
        padding: 1.25rem;
    }

    .form-label {
        font-weight: 500;
        color: #495057;
    }

    .form-control:focus {
        border-color: #17A2B8;
        box-shadow: 0 0 0 0.2rem rgba(23, 162, 184, 0.25);
    }
</style>
