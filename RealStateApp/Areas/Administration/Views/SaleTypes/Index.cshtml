@using RealStateApp.Core.Application.ViewModels.SaleType
@model List<SaleTypeViewModel>

@{
    Layout = "_AdminLayout";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-secondary">Tipos de Venta</h3>
        <a asp-action="Create" class="btn btn-primary px-4 rounded-3 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Crear Tipo
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center rounded-3">
            No hay tipos de venta registrados.
        </div>
    }
    else
    {
        <div class="card shadow-sm rounded-4">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="bg-light text-uppercase small text-muted">
                        <tr>
                            <th class="ps-4">Nombre</th>
                            <th>Descripción</th>
                            <th>Propiedades</th>
                            <th class="text-end pe-4">Opciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@item.Name</td>
                                <td>@item.Description</td>
                                <td>@item.PropertiesCount</td>
                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3 me-2">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                    <a asp-action="ConfirmDelete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f8f9fc !important;
    }

    .btn-outline-warning, .btn-outline-danger {
        font-size: 0.8rem;
    }
</style>
