@using RealStateApp.Core.Application.ViewModels.SaleType
@model List<SaleTypeViewModel>


@{
    Layout = "_AdminLayout";
}


<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-secondary">Mantenimiento de Tipos de Venta</h3>
        <a asp-action="Create" class="btn btn-primary">Crear Tipo de Venta</a>
    </div>


    <div class="card shadow-sm p-4">
        @if (Model.Count == 0)
        {
            <p class="text-muted text-center">No hay tipos de venta registrados.</p>
        }
        else
        {
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Cant. Propiedades</th>
                        <th class="text-end">Opciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Description</td>
                            <td>@item.PropertiesCount</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1">Editar</a>
                                <a asp-action="ConfirmDelete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>