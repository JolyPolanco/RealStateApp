@using RealStateApp.Core.Application.ViewModels.Properties
@using RealStateApp.Core.Application.ViewModels.SaleType
@model SaleTypeViewModel

@{
    Layout = "_AdminLayout";
}

<div class="container d-flex justify-content-center align-items-center mt-5" style="min-height: 60vh;">
    <div class="card shadow-sm border-0 p-4 text-center" style="max-width: 450px;">
        <h5 class="mb-3 text-muted">Confirmación de Eliminación</h5>
        <p>¿Está seguro que desea eliminar el tipo de venta <strong>@Model.Name</strong> y toda su información asociada?</p>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="text-muted small">@Model.Description</p>
        }
        <div class="mt-4 d-flex justify-content-center gap-3">
            <a asp-action="Index" asp-controller="SaleTypes" class="btn btn-outline-secondary px-4 rounded-3">Cancelar</a>
            <form method="post" asp-action="Delete" asp-controller="SaleTypes" asp-route-id="@Model.Id" class="d-inline">
                <button type="submit" class="btn btn-danger px-4 rounded-3">Aceptar</button>
            </form>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 0.75rem;
        transition: transform 0.2s ease-in-out;
    }

        .card:hover {
            transform: translateY(-3px);
        }

    .btn {
        min-width: 110px;
    }
</style>
