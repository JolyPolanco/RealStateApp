@using RealStateApp.Core.Application.ViewModels.User
@model List<UserViewModel>

@{
    Layout = "_AdminLayout";
}

<div class="container mt-5">
    <h2 class="mb-4 fw-light text-muted">Agentes Registrados</h2>

    <table class="table table-borderless align-middle">
        <thead class="text-uppercase text-muted small">
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Correo</th>
                <th>Propiedades</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var agent in Model)
            {
                <tr>
                    <td>@agent.FirstName</td>
                    <td>@agent.LastName</td>
                    <td>@agent.Email</td>
                    <td>
                        <span class="badge @(agent.IsVerified ? "bg-success" : "bg-secondary")">
                            @(agent.IsVerified ? "Sí" : "No")
                        </span>
                    </td>
                    <td>
                        <span class="badge @(agent.IsActive ? "bg-success" : "bg-danger")">
                            @(agent.IsActive ? "Activo" : "Inactivo")
                        </span>
                    </td>
                    <td class="text-end">
                        <a asp-controller"="Agents" asp-action="@(agent.IsActive ? "Deactivate" : "Activate")" asp-route-id="@agent.Id" class="d-inline">
                         
                        </a>
                        <a asp-action="Edit" asp-route-id="@agent.Id" class="btn btn-sm btn-outline-warning ms-2">
                            Editar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .table-borderless tbody tr:hover {
        background-color: #f8f9fa;
    }

    .badge {
        font-size: 0.8rem;
        padding: 0.4em 0.6em;
    }

    .btn-outline-warning, .btn-outline-success, .btn-outline-danger {
        font-size: 0.8rem;
        padding: 0.25rem 0.5rem;
    }
</style>
