@using RealStateApp.Core.Application.ViewModels.Properties
@model PropertyTypeViewModel

@{
    Layout = "_Layout";
}

<div class="container d-flex justify-content-center align-items-center mt-5" style="min-height: 60vh;">
    <div class="card shadow-sm border-0 p-4 text-center" style="max-width: 450px;">
        <h5 class="mb-3 text-muted">Confirmación de Eliminación</h5>
        <p>¿Está seguro que desea eliminar el tipo de propiedad <strong>@Model.Name</strong> y toda su información asociada?</p>
      
        <div class="mt-4 d-flex justify-content-center gap-3">
            <a asp-action="Index" asp-controller="PropertyTypes" class="btn btn-outline-secondary px-4 rounded-3">Cancelar</a>
            <form method="post" asp-action="Delete" asp-controller="PropertyTypes" asp-route-id="@Model.Id" class="d-inline">
                <button type="submit" class="btn btn-danger px-4 rounded-3">Aceptar</button>
            </form>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 0.75rem;
        transition: transform 0.2s ease-in-out;
    }

        .card:hover {
            transform: translateY(-3px);
        }

    .btn {
        min-width: 110px;
    }
</style>
