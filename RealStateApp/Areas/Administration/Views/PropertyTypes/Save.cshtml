@using RealStateApp.Core.Application.ViewModels.Properties
@model SavePropertyTypeViewModel
@{
    Layout = "_Layout";
}
<div class="container mt-5" style="max-width: 650px;">

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-light border-0 py-3 rounded-top-4">
            <h4 class="fw-semibold m-0 text-muted">
                @(Model.Id == null ? "Crear Tipo de Propiedad" : "Editar Tipo de Propiedad")
            </h4>
        </div>

        <div class="card-body p-4">
            <form asp-controller="PropertyTypes"
                  asp-action="@(Model.Id == null ? "Create" : "Edit")"
                  method="post"
                  class="needs-validation"
                  novalidate>

                <div class="mb-3">
                    <label class="form-label fw-medium">Nombre</label>
                    <input asp-for="Name" class="form-control rounded-3" placeholder="Ej. Residencial" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-medium">Descripción</label>
                    <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="Descripción del tipo de propiedad"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="PropertyTypes" asp-action="Index" asp-area="Administration" class="btn btn-outline-secondary px-4 rounded-3">
                        Atrás
                    </a>
                    <button type="submit" class="btn btn-primary px-4 rounded-3 shadow-sm">
                        Guardar
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).on("input", "input, textarea", function () {
            $(".text-danger").fadeOut();
        });
    </script>
}

<style>
    .form-control {
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
    }

    .card-header h4 {
        font-size: 1.25rem;
    }
</style>
