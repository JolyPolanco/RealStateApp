@using RealStateApp.Core.Application.ViewModels.Properties
@model List<PropertyTypeViewModel>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">Mantenimiento de Tipo de Propiedades</h3>

        <a asp-controller="PropertyTypes" asp-action="Create" class="btn btn-primary px-4">
            Crear nuevo tipo
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            No hay tipos de propiedades registrados.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Cantidad de propiedades</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Name</td>
                                <td>@item.Description</td>
                                <td>@item.PropertiesCount</td>

                                <td class="text-end">
                                    <a asp-controller="PropertyTypes"
                                       asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-secondary btn-sm">
                                        Editar
                                    </a>

                                    <a asp-controller="PropertyTypes"
                                       asp-action="ConfirmDelete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm ms-2">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
