@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@using RealStateApp.Core.Application.ViewModels.Properties
@model List<PropertyTypeViewModel>
@{
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-muted">Mantenimiento de Tipo de Propiedades</h3>

        <a asp-controller="PropertyTypes" asp-action="Create" class="btn btn-primary px-4 rounded-4 shadow-sm">
            Crear nuevo tipo
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center rounded-4 py-4 shadow-sm">
            <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
            No hay tipos de propiedades registrados.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="card-body p-0">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light text-uppercase small text-muted">
                        <tr>
                            <th class="ps-4">Nombre</th>
                            <th>Descripción</th>
                            <th>Cantidad de propiedades</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="hover-row">
                                <td class="fw-semibold ps-4">@item.Name</td>
                                <td>@item.Description</td>
                                <td>
                                    <span class="badge bg-primary rounded-pill px-3">@item.PropertiesCount</span>
                                </td>

                                <td class="text-end pe-4">
                                    <a asp-controller="PropertyTypes"
                                       asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-secondary btn-sm rounded-pill px-3 me-2">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>

                                    <a asp-controller="PropertyTypes"
                                       asp-action="ConfirmDelete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    .hover-row:hover {
        background-color: #f7f9fc;
        transition: 0.2s ease-in-out;
    }

    table {
        min-height: 120px;
    }
</style>
