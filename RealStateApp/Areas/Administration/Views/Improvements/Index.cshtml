@using RealStateApp.Core.Application.ViewModels.Improvement
@model List<ImprovementViewModel>

@{
    Layout = "_AdminLayout";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-secondary m-0">Mantenimiento de Mejoras</h3>
        <a asp-action="Create" class="btn btn-primary px-4 rounded-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Crear Mejora
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info text-center m-4">
                    No hay mejoras registradas.
                </div>
            }
            else
            {
                <table class="table table-hover align-middle mb-0">
                    <thead class="text-uppercase small text-muted bg-light">
                        <tr>
                            <th class="ps-4">Nombre</th>
                            <th>Descripción</th>
                            <th class="text-end pe-4">Opciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-medium">@item.Name</td>
                                <td>@item.Description</td>
                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-warning rounded-pill px-3 me-2">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                    <a asp-action="ConfirmDelete" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f8f9fc !important;
    }

    .table thead th {
        font-weight: 600;
        letter-spacing: 0.03em;
    }

    .btn-outline-warning,
    .btn-outline-danger,
    .btn-primary {
        font-size: 0.85rem;
        padding: 0.35rem 0.75rem;
    }

    .btn i {
        vertical-align: middle;
    }

    .card-body {
        padding: 0.5rem;
    }
</style>
