@using RealStateApp.Core.Application.ViewModels.Improvement
@model ImprovementViewModel


@{
    Layout = "_AdminLayout";
}


<div class="container d-flex justify-content-center align-items-center mt-5" style="min-height: 60vh;">
    <div class="card shadow-sm border-0 p-4 text-center" style="max-width: 400px;">
        <h5 class="mb-3 text-muted">Confirmación de Eliminación</h5>
        <p>¿Está seguro que desea eliminar la mejora <strong>@Model.Name</strong>?</p>
        <p class="text-muted small">@Model.Description</p>


        <div class="mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary me-2">Cancelar</a>


            <form method="post" asp-action="Delete" asp-route-id="@Model.Id" class="d-inline">
                <button type="submit" class="btn btn-danger">Aceptar</button>
            </form>
        </div>
    </div>
</div>


<style>
    .card {
        border-radius: 0.5rem;
    }
</style>