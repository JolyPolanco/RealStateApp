@using RealStateApp.Core.Application.ViewModels.Improvement
@model ImprovementViewModel


@{
Layout = "_AdminLayout";
bool editing = Model.Id != 0;
}


<div class="container mt-4" style="max-width: 600px;">
<div class="card shadow-sm p-4">
<h4 class="mb-3 text-secondary">@(editing ? "Editar Mejora" : "Crear Mejora")</h4>


<form method="post">
<div class="mb-3">
<label class="form-label">Nombre</label>
<input asp-for="Name" class="form-control" />
<span asp-validation-for="Name" class="text-danger small"></span>
</div>


<div class="mb-3">
<label class="form-label">Descripción</label>
<textarea asp-for="Description" class="form-control" rows="3"></textarea>
<span asp-validation-for="Description" class="text-danger small"></span>
</div>


<div class="d-flex justify-content-between mt-4">
<a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
<button type="submit" class="btn btn-primary">@(editing ? "Guardar" : "Crear")</button>
</div>
</form>
</div>
</div>


