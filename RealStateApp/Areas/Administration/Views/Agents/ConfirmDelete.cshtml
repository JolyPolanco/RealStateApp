@using RealStateApp.Core.Application.ViewModels.User
@model AgentViewModel

@{
    Layout = "_Layout";
}

<div class="container d-flex justify-content-center align-items-center mt-5" style="min-height: 60vh;">
    <div class="card delete-card p-5 shadow text-center">
        <h4 class="fw-semibold text-dark mb-3">Confirmación de Eliminación</h4>

        <p class="text-secondary mb-1">
            ¿Está seguro que desea eliminar el agente
            <strong>@Model.FirstName @Model.LastName</strong>?
        </p>

        <p class="text-danger fw-semibold small">
            Esta acción también eliminará todas sus propiedades.
        </p>

        <p class="text-muted small mb-4">@Model.Email</p>

        <div class="d-flex justify-content-center gap-3 mt-3">
            <a asp-area="Administration"
               asp-controller="Agents"
               asp-action="Index"
               class="btn btn-cancel px-4">
                Cancelar
            </a>

            <form method="post"
                  asp-area="Administration"
                  asp-controller="Agents"
                  asp-action="DeleteAgent"
                  asp-route-id="@Model.Id"
                  class="d-inline">
                <button type="submit" class="btn btn-confirm px-4">
                    Aceptar
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    .delete-card {
        max-width: 420px;
        border-radius: 1rem;
        border: 1px solid #e4e6eb;
        background: #ffffff;
        transition: all .25s ease-in-out;
    }

        .delete-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 26px rgba(0,0,0,0.12);
        }

    /* Botón cancelar */
    .btn-cancel {
        background-color: #f3f4f6;
        border: 1px solid #d1d5db;
        color: #374151;
        font-weight: 500;
        border-radius: 0.6rem;
        transition: .2s;
        min-width: 120px;
    }

        .btn-cancel:hover {
            background-color: #e5e7eb;
            border-color: #c7cbd1;
        }

    /* Botón aceptar */
    .btn-confirm {
        background-color: #dc3545;
        border: 1px solid #b52a36;
        color: #fff;
        font-weight: 500;
        border-radius: 0.6rem;
        transition: .2s;
        min-width: 120px;
    }

        .btn-confirm:hover {
            background-color: #c82333;
            border-color: #a71d2a;
            transform: scale(1.03);
            box-shadow: 0 6px 14px rgba(0,0,0,0.15);
        }
</style>
