@model string
@{
    Layout = "_Layout";
    bool isActivateMode = ViewBag.IsActivateMode ?? false;
    string actionText = isActivateMode ? "activar" : "desactivar";
    string headerText = isActivateMode ? "Confirmación de Activación" : "Confirmación de Desactivación";
    string messageText = isActivateMode
        ? "¿Está seguro que desea activar este administrador?"
        : "¿Está seguro que desea desactivar este administrador?";
}

<div class="container d-flex justify-content-center align-items-center mt-5" style="min-height: 60vh;">
    <div class="card border-0 shadow-sm p-4 text-center" style="max-width: 450px;">
        <h4 class="mb-3 text-muted">@headerText</h4>
        <p class="mb-4">@messageText</p>

        <div class="d-flex justify-content-center gap-3">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>

            <form method="post" asp-action="ToggleState" asp-route-id="@Model" asp-controller"="Administrators">
                <button type="submit" class="btn btn-@(isActivateMode ? "success" : "warning") px-4">
                    @(isActivateMode ? "Activar" : "Desactivar")
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 0.75rem;
        transition: transform 0.2s ease-in-out;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .btn {
        font-weight: 500;
    }

    .btn-outline-secondary {
        min-width: 120px;
    }

    .btn-success, .btn-warning {
        min-width: 120px;
    }
</style>
