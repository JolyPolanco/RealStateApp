@using RealStateApp.Core.Application.ViewModels.User
@model List<UserViewModel>

@{
    Layout = "_AdminLayout";
    string currentUserId = ViewBag.CurrentUserId ?? "";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-light text-muted">Administradores</h2>
        <a asp-action="Create" class="btn btn-primary px-4">Crear Administrador</a>
    </div>

    <table class="table table-borderless align-middle shadow-sm rounded">
        <thead class="bg-light text-uppercase text-muted small">
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Usuario</th>
                <th>Cédula</th>
                <th>Correo</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var admin in Model)
            {
                bool isCurrent = admin.Id == currentUserId;

                <tr class="align-middle">
                    <td>@admin.FirstName</td>
                    <td>@admin.LastName</td>
                    <td>@admin.UserName</td>
                    <td>@admin.Dni</td>
                    <td>@admin.Email</td>
                    <td>
                        <span class="badge @(admin.IsActive ? "bg-success" : "bg-danger")">
                            @(admin.IsActive ? "Activo" : "Inactivo")
                        </span>
                    </td>
                    <td class="text-end">
                        @if (!isCurrent)
                        {
                            <form method="post" asp-action="ToggleState" asp-route-id="@admin.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-@(admin.IsActive ? "warning" : "success")">
                                    @(admin.IsActive ? "Inactivar" : "Activar")
                                </button>
                            </form>
                            <a asp-action="Edit" asp-controller="Administrators" asp-route-id="@admin.Id" class="btn btn-sm btn-outline-primary ms-2">Editar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .table-borderless tbody tr:hover {
        background-color: #f8f9fa;
    }

    .badge {
        font-size: 0.8rem;
        padding: 0.4em 0.6em;
    }

    .btn-outline-warning, .btn-outline-success, .btn-outline-primary {
        font-size: 0.8rem;
        padding: 0.25rem 0.5rem;
    }

    .table {
        border-radius: 0.5rem;
        overflow: hidden;
    }
</style>
