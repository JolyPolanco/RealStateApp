@using RealStateApp.Core.Application.ViewModels.User
@model List<UserViewModel>

@{
    Layout = "_AdminLayout";
    string currentUserId = ViewBag.CurrentUserId ?? "";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-light text-muted">Administradores</h2>
        <a asp-action="Create" class="btn btn-primary px-4 shadow-sm rounded-3 btn-create">
            <i class="bi bi-person-plus-fill me-2"></i> Crear Administrador
        </a>
    </div>

    <div class="table-wrapper bg-white p-3 rounded-4 shadow-sm">

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-person-gear display-4 mb-3"></i>
                <h5 class="fw-light">No hay administradores registrados</h5>
                <p class="small">Agregue un administrador para visualizarlo en la lista.</p>
            </div>
        }
        else
        {
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-uppercase text-muted small">
                    <tr>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Usuario</th>
                        <th>Cédula</th>
                        <th>Correo</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var admin in Model)
                    {
                        bool isCurrent = admin.Id == currentUserId;

                        <tr class="align-middle">
                            <td>@admin.FirstName</td>
                            <td>@admin.LastName</td>
                            <td>@admin.UserName</td>
                            <td>@admin.Dni</td>
                            <td>@admin.Email</td>

                            <td>
                                <span class="badge @(admin.IsActive ? "bg-success" : "bg-danger") rounded-pill px-3 py-2">
                                    @(admin.IsActive ? "Activo" : "Inactivo")
                                </span>
                            </td>

                            <td class="text-end">

                                @if (!isCurrent)
                                {
                                    <div class="d-flex gap-2 justify-content-end">

                                        <!-- Activar / Desactivar -->
                                        <form method="post"
                                              asp-action="@(admin.IsActive ? "Deactivate" : "Activate")"
                                              asp-route-id="@admin.Id"
                                              class="d-inline">
                                            <button type="submit"
                                                    class="btn btn-action btn-outline-@(admin.IsActive ? "warning" : "success")">
                                                <i class="bi bi-power me-1"></i> @(admin.IsActive ? "Desactivar" : "Activar")
                                            </button>
                                        </form>

                                        <!-- Editar -->
                                        <a asp-action="Edit"
                                           asp-controller="Administrators"
                                           asp-route-id="@admin.Id"
                                           asp-area="Administration"
                                           class="btn btn-action btn-outline-primary">


                                            <i class="bi bi-pencil-square me-1"></i> Editar
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex gap-2 justify-content-end opacity-50">
                                        <button class="btn btn-action btn-secondary disabled">
                                            <i class="bi bi-power me-1"></i> @(admin.IsActive ? "Desactivar" : "Activar")
                                        </button>
                                        <button class="btn btn-action btn-secondary disabled">
                                            <i class="bi bi-pencil-square me-1"></i> Editar
                                        </button>
                                    </div>
                                }

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

    </div>
</div>

<style>
    .table-wrapper {
        border-radius: 1rem;
        overflow: hidden;
        min-height: 350px;
    }

    .table-hover tbody tr:hover {
        background-color: #f7f9fc;
    }

    thead tr {
        background-color: #f1f3f5 !important;
    }

    .table td, .table th {
        padding: 0.9rem 0.75rem;
        vertical-align: middle;
    }

    .badge {
        font-size: 0.75rem;
        font-weight: 500;
    }

    /* Mejor estética de botones */
    .btn-action {
        padding: 0.35rem 0.6rem;
        font-size: 0.78rem;
        border-radius: 8px;
        display: flex;
        align-items: center;
        transition: all 0.15s ease-in-out;
    }

        .btn-action i {
            font-size: 0.9rem;
        }

        .btn-action:hover:not(.disabled) {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.12);
        }

    /* Colores personalizados */
    .btn-outline-warning {
        border-color: #e0a800;
        color: #e0a800;
    }

        .btn-outline-warning:hover {
            background-color: #e0a800;
            color: white;
        }

    .btn-outline-success {
        border-color: #2e8b57;
        color: #2e8b57;
    }

        .btn-outline-success:hover {
            background-color: #2e8b57;
            color: white;
        }

    .btn-outline-primary {
        border-color: #0d6efd;
        color: #0d6efd;
    }

        .btn-outline-primary:hover {
            background-color: #0d6efd;
            color: white;
        }

    .btn-create i {
        font-size: 1rem;
    }
</style>
